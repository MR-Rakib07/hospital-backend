generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
  STAFF
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AppointmentType {
  ONLINE
  OFFLINE
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

model User {
  id                   String         @id @default(auto()) @map("_id") @db.ObjectId
  email                String         @unique
  password             String
  role                 Role           @default(PATIENT)
  fullname             String
  phone                String
  dateOfBirth          DateTime?
  gender               Gender?
  bloodGroup           BloodGroup?
  maritalStatus        MaritalStatus?
  presentAddress       String?
  permanentAddress     String?
  emergencyContactName String?
  emergencyRelation    String?
  emergencyPhone       String?
  
  isActive             Boolean        @default(true)
  isDeleted            Boolean        @default(false)

  doctorProfile        DoctorProfile?
  adminProfile         AdminProfile?
  staffProfile         StaffProfile?
  appointments         Appointment[]  @relation("PatientAppointments")
  
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@map("users")
}

model DoctorProfile {
  id                  String         @id @default(auto()) @map("_id") @db.ObjectId
  userId              String?        @unique @db.ObjectId
  user                User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  department          String
  specialization      String
  designation         String?
  experience          Int            @default(0)
  fee                 Float          @default(0)
  teleconsultationFee Float?         @default(0)
  image               String?
  availableDays       String[]
  visitingHours       String?
  roomNumber          String?
  floorNumber         String?
  
  isAvailable         Boolean        @default(true)
  isEmployed          Boolean        @default(true)

  appointments        Appointment[]  @relation("DoctorAppointments")
  
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@map("doctor_profiles")
}

model AdminProfile {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  userId      String?   @unique @db.ObjectId
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  designation String?
  department  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("admin_profiles")
}

model StaffProfile {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  userId        String?   @unique @db.ObjectId
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  counterNumber String?
  department    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("staff_profiles")
}

model Appointment {
  id              String            @id @default(auto()) @map("_id") @db.ObjectId
  serialNumber    Int
  serialCode      String?
  appointmentDate DateTime
  type            AppointmentType   @default(OFFLINE)
  status          AppointmentStatus @default(PENDING)
  problemDetails  String?

  patientName     String
  patientPhone    String
  patientEmail    String?
  patientAge      Int?
  patientGender   Gender?

  meetingRoomId   String?
  meetingLink     String?

  paymentStatus   PaymentStatus     @default(UNPAID)
  transactionId   String?
  paidAmount      Float             @default(0)

  patientId       String?           @db.ObjectId
  patient         User?             @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: SetNull)

  doctorId        String?           @db.ObjectId
  doctor          DoctorProfile?    @relation("DoctorAppointments", fields: [doctorId], references: [id], onDelete: SetNull)

  prescription    Prescription?     @relation("AppointmentPrescription")

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([patientPhone, serialNumber])
  @@index([appointmentDate, doctorId])
  @@index([serialCode])
  @@map("appointments")
}

model Prescription {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  appointmentId String      @unique @db.ObjectId
  appointment   Appointment @relation("AppointmentPrescription", fields: [appointmentId], references: [id], onDelete: Cascade)
  diagnosis     String?
  medicines     Json?
  advice        String?
  pdfUrl        String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("prescriptions")
}

model Department {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  name            String    @unique
  specializations String[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("departments")
}

model Designation {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("designations")
}